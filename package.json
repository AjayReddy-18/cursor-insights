{
  "name": "cursor-insights",
  "displayName": "Cursor Insights",
  "description": "Monitor Cursor AI usage, recent requests and high-cost request alerts directly inside Cursor.",
  "version": "1.2.0",
  "publisher": "ajayreddy",
  "icon": "images/icon.png",
  "author": {
    "name": "Ajay Reddy",
    "email": "iamajayreddy18@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AjayReddy-18/cursor-insights.git"
  },
  "homepage": "https://github.com/AjayReddy-18/cursor-insights#readme",
  "bugs": {
    "url": "https://github.com/AjayReddy-18/cursor-insights/issues"
  },
  "keywords": [
    "cursor",
    "cursor ai",
    "cursor usage",
    "usage",
    "billing",
    "cost",
    "dashboard",
    "tokens",
    "insights",
    "ai"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:cursorInsights.dashboard"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cursor-insights.connect",
        "title": "Cursor Insights: Connect Account"
      },
      {
        "command": "cursor-insights.refresh",
        "title": "Cursor Insights: Refresh"
      },
      {
        "command": "cursor-insights.openInsights",
        "title": "Cursor Insights: Open Cursor Insights"
      },
      {
        "command": "cursor-insights.openDashboard",
        "title": "Cursor Insights: Open Cursor Usage Dashboard"
      },
      {
        "command": "cursor-insights.showLogs",
        "title": "Cursor Insights: Show Logs"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cursor-insights",
          "title": "Cursor Insights",
          "icon": "media/cursor-insights.svg"
        }
      ]
    },
    "views": {
      "cursor-insights": [
        {
          "type": "webview",
          "id": "cursorInsights.dashboard",
          "name": "Dashboard"
        }
      ]
    },
    "configuration": {
      "title": "Cursor Insights",
      "properties": {
        "cursorInsights.alertThreshold": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 10,
          "description": "Show a notification when a single Cursor request costs more than this amount (USD)."
        },
        "cursorInsights.conversationInsightsTimeframe": {
          "type": "string",
          "default": "MTD",
          "enum": [
            "1D",
            "7D",
            "30D",
            "MTD"
          ],
          "description": "Timeframe for Conversation Insights analytics."
        },
        "cursorInsights.conversationInsightsMetric": {
          "type": "string",
          "default": "categories",
          "enum": [
            "workType",
            "intentDistribution",
            "categories",
            "taskComplexity",
            "promptSpecificity"
          ],
          "enumDescriptions": [
            "Work Type",
            "Intent Distribution",
            "Categories",
            "Task Complexity",
            "Prompt Specificity"
          ],
          "description": "Metric shown in the Conversation Insights chart."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "mocha --ui tdd --require ./src/test/vscode-mock.cjs --timeout 20000 'out/test/**/*.test.js'",
    "test:electron": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
